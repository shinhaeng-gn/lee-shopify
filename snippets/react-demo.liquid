{% doc %}
  리액트로 개발된 웹 컴포넌트 사용 예시입니다.
  'assets/react-components.js' 파일이 빌드되어 있어야 합니다.

  @param {string} title - 컴포넌트에 표시할 제품 제목
  @param {string} product_id - 컴포넌트에 표시할 제품 ID
{% enddoc %}

{%- liquid
  # 빌드된 JS 파일을 불러옵니다.
  # defer 또는 async를 사용하여 페이지 로딩 성능을 최적화할 수 있습니다.
-%}
<script src="{{ 'react-components.js' | asset_url }}" defer="defer"></script>

<div class="react-component-wrapper">
  <!-- 
    React 컴포넌트가 Web Component(product-alert)로 등록되었습니다.
    Liquid 변수를 속성(attribute)으로 직접 전달합니다.
  -->
  <product-alert 
    title="{{ title | escape }}" 
    product-id="{{ product_id }}"
  ></product-alert>
</div>

<style>
  .react-component-wrapper {
    margin: 20px 0;
  }
</style>
