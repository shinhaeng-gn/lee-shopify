<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.show_component -%}
      <script src="{{ 'react-components.js' | asset_url }}" defer="defer"></script>

      <div class="react-container">
        <!--
          Web Component 속성은 하이픈 형식을 권장합니다.
          r2wc가 자동으로 camelCase(buttonColor)로 변환해줍니다.
        -->
        <product-alert
          title="{{ section.settings.alert_title | escape }}"
          description="{{ section.settings.alert_description | escape }}"
          button-text="{{ section.settings.button_text | escape }}"
          button-color="{{ section.settings.button_color }}"
        ></product-alert>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "리액트 알림 섹션",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_component",
      "label": "컴포넌트 표시 여부",
      "default": true
    },
    {
      "type": "text",
      "id": "alert_title",
      "label": "알림 제목",
      "default": "리액트 제목"
    },
    {
      "type": "textarea",
      "id": "alert_description",
      "label": "알림 내용",
      "default": "여기에 상세 내용을 입력하세요."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "버튼 텍스트",
      "default": "확인하기"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "버튼 배경색",
      "default": "#008060"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "색상 스키마",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "리액트 알림 섹션"
    }
  ]
}
{% endschema %}

<style>
  .react-container {
    padding: 2rem 0;
  }
</style>
